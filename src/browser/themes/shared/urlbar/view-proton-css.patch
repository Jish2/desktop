   -moz-window-dragging: no-drag;
 
   display: none;
+  /* The fork makes the <moz-urlbar> element itself the popover rather than
+     .panel (see UrlbarInputBase), so the view has no host that un-hides it.
+     Stock FF160 relies on .panel being the popover element and therefore
+     ships no [open] rule; without this the view stays display:none and
+     results never paint. */
+  .urlbar[breakout][open] > & {
+    display: flex;
+    flex-direction: column;
+  }
+
   text-shadow: none;
   overflow: clip;
   margin-inline: var(--urlbarview-margin-inline);
